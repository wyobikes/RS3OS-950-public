# Every rule here names a specific path and says what puts the file back.
# Nothing is ignored by bare extension or by blanket directory: a rule that
# swallows hand-written work is invisible, because the file simply is not there
# to notice.

# --- build output -----------------------------------------------------------
# Regenerated by: gradlew installDist
/build/
/.gradle/
/tools/__pycache__/

# --- your private key -------------------------------------------------------
# Generated by: setup.ps1 (rs3os run-tool rsa-key-generator)
# This is the RSA private key your patched client trusts. It must never be
# published. Anyone with it can impersonate your server to your client.
/data/config/rsa.toml

# --- your deployment's configuration ----------------------------------------
# Written by setup.ps1 from the .example files beside them.
/data/config/server.toml
/data/config/mods.json
/data/config/proxy.toml
/data/config/login-varps-950.tsv

# --- the game cache ---------------------------------------------------------
# Downloaded by: setup.ps1 (rs3os run-tool cache-downloader)
/data/cache/

# --- data derived from your cache -------------------------------------------
# Built by setup.ps1 from the cache you downloaded; not redistributable.
/data/rs3.sqlite
/data/rs3.sqlite-shm
/data/rs3.sqlite-wal
/data/rs3.built.sqlite
/data/rs3.building.sqlite
/data/rs3.building.sqlite-journal
/data/seed/npc_cache.json

# --- player accounts --------------------------------------------------------
# Created by the server on first login. Contains your players' data.
/data/accounts.sqlite
/data/accounts.sqlite-shm
/data/accounts.sqlite-wal

# --- client binaries and the client's own files ------------------------------
# Downloaded and patched by setup.ps1; written by the client while it runs.
/data/clients/
/data/launchers/
/data/client/

# --- runtime output ---------------------------------------------------------
# Written by the running server.
/logs/
/data/diag/
/data/proxy/
/data/resources/

# --- editors and OS ---------------------------------------------------------
/.idea/
*.iml
.DS_Store
Thumbs.db
